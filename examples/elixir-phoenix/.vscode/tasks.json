{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "port-forward-debug",
            "type": "shell",
            "command": "${workspaceFolder}/manage.sh",
            "args": [
                "port-forward-debug"
            ],
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Forwarding from",
                    "endsPattern": "^Forwarding from.*9000"
                }
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": false
            }
        },
        {
            "label": "build",
            "type": "shell",
            "command": "${workspaceFolder}/manage.sh",
            "args": [
                "build"
            ],
            "group": "build"
        },
        {
            "label": "deploy",
            "type": "shell",
            "command": "${workspaceFolder}/manage.sh",
            "args": [
                "deploy"
            ],
            "dependsOn": ["build"]
        },
        {
            "label": "logs",
            "type": "shell",
            "command": "${workspaceFolder}/manage.sh",
            "args": [
                "logs",
                "--follow"
            ],
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "start-phoenix",
            "type": "shell",
            "command": "${workspaceFolder}/manage.sh",
            "args": [
                "start-phoenix"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}